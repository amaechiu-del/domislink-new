# Copy this file to .env and replace every placeholder before starting production services.
# Never commit .env or paste these values into client-side Vite variables.

# Database Configuration
POSTGRES_DB=domislink
POSTGRES_USER=domislink
POSTGRES_PASSWORD=replace-with-a-strong-unique-secret
DATABASE_URL=postgresql://domislink:replace-with-a-strong-unique-secret@domislink-db:5432/domislink

# Redis Configuration
REDIS_URL=redis://domislink-redis:6379

# Server-only LLM API keys
HUGGINGFACE_API_KEY=replace-with-server-side-key
COHERE_API_KEY=replace-with-server-side-key
OPENAI_API_KEY=replace-with-server-side-key

# Application Configuration
NODE_ENV=production
PORT=3000
AI_PROCTORING_SERVICE=http://ai-proctoring:5001

# CI/CD deployment secret
RENDER_API_KEY=replace-with-deployment-key
